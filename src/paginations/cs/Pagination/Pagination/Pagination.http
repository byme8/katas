@Host = http://localhost:10000
@companyId = 100
@smallCompanyId = 1

GET {{Host}}/api/companies
Accept: application/json

###
# Offset-based pagination for companies
POST {{Host}}/api/companies/offset
Accept: application/json
Content-Type: application/json

{
  "page": 1,
  "size": 10,
  "orderBy": "NAME",
  "direction": "ASC"
}

###
GET {{Host}}/api/companies/{{companyId}}/users
Accept: application/json

###
# Offset-based pagination for company users
POST {{Host}}/api/companies/{{companyId}}/users/offset
Accept: application/json
Content-Type: application/json

{
  "page": 10,
  "size": 100,
  "orderBy": "CREATED_AT",
  "direction": "DESC"
}

###

# Get all users
GET {{Host}}/api/users/all
Accept: application/json

###

# Offset-based pagination for all users
POST {{Host}}/api/users/offset
Accept: application/json
Content-Type: application/json

{
  "page": 1,
  "size": 100,
  "skipCount": false,
  "orderBy": "CREATED_AT",
  "direction": "DESC"
}

###

# Offset-based pagination for all users
POST {{Host}}/api/users/offset
Accept: application/json
Content-Type: application/json

{
  "page": 100000,
  "size": 10,
  "skipCount": true,
  "orderBy": "CREATED_AT",
  "direction": "DESC"
}

###
# Get all users for Small Company (should return 15 users)
GET {{Host}}/api/companies/{{smallCompanyId}}/users
Accept: application/json

###
# Offset-based pagination for Small Company users
POST {{Host}}/api/companies/{{smallCompanyId}}/users/offset
Accept: application/json
Content-Type: application/json

{
  "page": 1,
  "size": 10,
  "orderBy": "NAME",
  "direction": "ASC"
}

###
# Cursor-based pagination for all users (first page)
POST {{Host}}/api/users/cursor
Accept: application/json
Content-Type: application/json

{
  "size": 5,
  "order": {
    "orderBy": "CREATED_AT",
    "direction": "DESC"
  }
}

###
# Cursor-based pagination for all users (with cursor)
POST {{Host}}/api/users/cursor
Accept: application/json
Content-Type: application/json

{
  "size": 5,
  "cursor": "lM4BkTcgCtMAAAAAaE4RLAI="
}